# Environment Configuration Example
# DO NOT commit actual credentials to GitHub
# Copy this to a local config file and update with real values

# ============================================
# Google Cloud Configuration
# ============================================
# Get this from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# ============================================
# Security Settings
# ============================================
# Session timeout in milliseconds (default: 30 minutes)
SESSION_TIMEOUT=1800000

# Maximum API requests per hour
RATE_LIMIT_MAX_REQUESTS=100

# Enable data encryption (recommended: true)
ENCRYPTION_ENABLED=true

# Require Google authentication (recommended: true)
REQUIRE_AUTH=true

# ============================================
# Google Drive API Configuration
# ============================================
# Folder ID where bills are stored (optional)
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# ============================================
# Application Settings
# ============================================
# Application name
APP_NAME=نظام إدارة الفواتير - الذهب الأبيض

# Support email
SUPPORT_EMAIL=support@example.com

# ============================================
# Audit & Logging
# ============================================
# Maximum audit log entries to keep
MAX_AUDIT_LOGS=1000

# Enable console logging (for development)
ENABLE_CONSOLE_LOGS=false
